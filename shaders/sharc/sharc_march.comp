// Pictor — SHaRC 拡張 Pass 1: March / Trace
//
// レイごとにハッシュグリッドを DDA で歩き、 触れたセルを spatial hash へ
// atomic 登録 (atomicCAS 重複排除) しつつ、 ヒット列 (ray, slot, t区間) を
// SoA 保存する (spec §3)。
// レベルはレイ上の点とカメラの距離で選択 (遠方ほど粗いセル)。
//
// RT コア (ray query) は「ボリューム空間スキップ / 可視性」 用で、
// SHARC_RAY_QUERY 定義時のみ有効化する将来枝。 既定はピュア compute。

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

#define SHARC_SET 0
#include "sharc_common.glsl"

// 入力レイ (AoS)
struct SharcRay {
    vec4 originTMin;   // xyz = 原点, w = tMin
    vec4 dirTMax;      // xyz = 方向 (正規化), w = tMax
};

layout(std430, set = SHARC_SET, binding = 3) readonly buffer SharcRays {
    SharcRay gpu_sharc_rays[];
};

// カウンタ群: [0]=予約 [1]=requestCount [2..3]=予約
// (ヒット列は resolve が読まないため廃止 — 最大 5900 万 atomic/frame の
//  無駄だった。 review P1-05。 volume 積分フェーズで必要になれば
//  tile queue として再設計する)
layout(std430, set = SHARC_SET, binding = 5) buffer SharcCounters {
    uint gpu_sharc_counters[];
};

// per-cell reservoir (新規スロットの payload 初期化用)
layout(std430, set = SHARC_SET, binding = 10) buffer SharcReservoirs {
    uvec4 gpu_sharc_reservoirs[];
};

// 今フレームの要求セルリスト (compact が indirect 引数化する)
layout(std430, set = SHARC_SET, binding = 6) writeonly buffer SharcRequests {
    uint gpu_sharc_requests[];
};

// スロットごとの要求スタンプ (フレーム内重複排除)
layout(std430, set = SHARC_SET, binding = 7) buffer SharcRequestStamps {
    uint gpu_sharc_stamps[];
};


// 触れたセルを登録し、 今フレーム初出なら要求リストに積む。
uint sharcRegisterCell(ivec3 grid, uint level) {
    bool inserted;
    uint slot = sharcInsertSlot(grid, level, inserted);
    if (slot == SHARC_SLOT_INVALID) return slot;

    if (inserted) {
        // 新規セルは全 payload を初期化 (CAS 勝者のみが書く)。
        // スロット再利用時に旧空間の moments/lobes/reservoir を約 95%
        // 継承してしまう光漏れ・残像対策 (review P0-03)
        uint base = sharcCellBase(slot);
        for (uint i = 0u; i < SHARC_CELL_UINTS; i++) {
            gpu_sharc_cells[base + i] = 0u;
        }
        gpu_sharc_reservoirs[slot] = uvec4(0u);
        for (uint i = 0u; i < SHARC_ACCUM_UINTS; i++) {
            gpu_sharc_accum[slot * SHARC_ACCUM_UINTS + i] = 0u;
        }
        sharcStoreMeta(slot, 0u, sharcFrameIndex & 0xFFFFu, 0.0, 0.0, level, 1.0);
        gpu_sharc_cell_pos[slot] = sharcPackGridLevel(grid, level);
    }
    // 収束セルの凍結: 履歴が十分 (4096 サンプル ≈ 64 フレーム) なら
    // 要求を出さない — 静的シーン + 静的ライトでは update コストが
    // 漸近ゼロになる (実行時の事前計算化)。 ライト変更時はキャッシュ
    // クリアで解凍する (将来: light revision 連動)
    {
        uint metaCount = gpu_sharc_cells[sharcCellBase(slot)
                                         + SHARC_CELL_OFFSET_META] & 0xFFFFu;
        if (metaCount >= 4096u) return slot;
    }
    // 通常読みで既登録なら atomic を踏まない (多数派の fast path)
    if (gpu_sharc_stamps[slot] != sharcFrameIndex) {
        uint prevStamp = atomicExchange(gpu_sharc_stamps[slot],
                                        sharcFrameIndex);
        if (prevStamp != sharcFrameIndex) {
            uint idx = atomicAdd(gpu_sharc_counters[1], 1u);
            if (idx < sharcTableSize) {
                gpu_sharc_requests[idx] = slot;
            }
        }
    }
    return slot;
}

// セル要求はワールド空間で粗いため、 march は表示解像度の 1/4×1/4
// (1/16 レイ数) で十分 — フル解像度だと同一セルを数千レイが重複タッチ
// するだけ。 4K 時のレイ数抑制の要 (hit / shadow / resolve は表示解像度)。
const uint SHARC_MARCH_STRIDE = 4u;

void main() {
    // 低解像度グリッド index → 表示解像度のレイ index へ (stride サンプリング)
    uint renderW = uint(sharcCamUp.w);
    uint renderH = sharcRayCount / renderW;
    uint lowW = (renderW + SHARC_MARCH_STRIDE - 1u) / SHARC_MARCH_STRIDE;
    uint lowH = (renderH + SHARC_MARCH_STRIDE - 1u) / SHARC_MARCH_STRIDE;
    uint lowIdx = gl_GlobalInvocationID.x;
    if (lowIdx >= lowW * lowH) return;
    uint px = (lowIdx % lowW) * SHARC_MARCH_STRIDE;
    uint py = (lowIdx / lowW) * SHARC_MARCH_STRIDE;
    uint rayIdx = py * renderW + px;
    if (rayIdx >= sharcRayCount) return;

    SharcRay ray = gpu_sharc_rays[rayIdx];
    vec3 ro = ray.originTMin.xyz;
    vec3 rd = ray.dirTMax.xyz;
    float t    = max(ray.originTMin.w, 0.0);
    float tMax = ray.dirTMax.w;

    for (uint step = 0u; step < sharcMaxRaySteps && t < tMax; step++) {
        vec3 p = ro + rd * t;
        uint level = sharcLevelFromDistance(distance(p, sharcCameraPos.xyz));
        float cell = sharcCellSize(level);
        ivec3 grid = ivec3(floor(p / cell));

        // DDA: 現セルの exit t (数値誤差はマージンで押し出す)
        vec3 cellMin = vec3(grid) * cell;
        vec3 cellMax = cellMin + cell;
        vec3 tExit3 = vec3(1e30);
        for (int a = 0; a < 3; a++) {
            if (rd[a] > SHARC_EPSILON)       tExit3[a] = (cellMax[a] - ro[a]) / rd[a];
            else if (rd[a] < -SHARC_EPSILON) tExit3[a] = (cellMin[a] - ro[a]) / rd[a];
        }
        float tExit = min(min(tExit3.x, tExit3.y), min(tExit3.z, tMax));

        sharcRegisterCell(grid, level);

        t = tExit + sharcHitEpsilon;
    }

    // レイ終端 (= ヒット点) の周囲 2x2x2 セルを追加登録する。
    // resolve のトライリニア補間評価 (セル境界の切れ目対策) が
    // 近傍セルのデータを必要とするため。 レベル選択は resolve と同一式。
    vec3 endPos = ro + rd * tMax;
    uint endLevel = sharcLevelFromDistance(distance(endPos,
                                                    sharcCameraPos.xyz));
    float endCell = sharcCellSize(endLevel);
    ivec3 endBase = ivec3(floor(endPos / endCell - 0.5));
    for (int c = 0; c < 8; c++) {
        ivec3 offs = ivec3(c & 1, (c >> 1) & 1, (c >> 2) & 1);
        sharcRegisterCell(endBase + offs, endLevel);
    }
}
