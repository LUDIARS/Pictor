// Pictor — SHaRC 拡張 Pass 0: Hit (GPU レイ生成 + 一次交差)
//
// CPU 側 BVH トレースの置き換え。 RT 拡張 (ray query) を使わず、
// フラット BVH (DoD 配列そのままの SSBO) を compute で辿る —
// Pascal 世代 (RT 拡張なし) と CI の両方で動く。 RT コア版は
// SHARC_RAY_QUERY の将来枝 (spec §3)。
//
//   入力: カメラ基底 (UBO) — レイは画素 index から GPU 上で生成する。
//         CPU からのレイ転送・読み戻しはなし (全 GPU 経路)。
//   出力: rays[] (march 用、 tMax = 実ヒット距離)
//         shade[] (位置 / 法線 / マテリアル / 視線)
//
// BVH 規約は demo/sharc/mesh_bvh.cpp と同一: 左子 = 自ノード + 1、
// 葉は tri 開始 index + 数。 三角形は葉順に並べ替え済み (連続参照)。
//
// dispatch: (rayCount / 64, 1, 1)

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

#define SHARC_SET 0
#include "sharc_common.glsl"

struct SharcRay {
    vec4 originTMin;   // xyz = 原点, w = tMin
    vec4 dirTMax;      // xyz = 方向 (正規化), w = tMax (hit で更新)
};

layout(std430, set = SHARC_SET, binding = 3) writeonly buffer SharcRays {
    SharcRay gpu_sharc_rays[];
};

struct SharcShadeRequest {
    vec4 posRough;     // xyz = ヒット点, w = roughness
    vec4 normalMfp;    // xyz = 法線 (外向き), w = SSS MFP (0 = SSS 無効)
    vec4 albedoView;   // rgb = albedo, a = 予約
    vec4 viewDir;      // xyz = ヒット点→カメラ方向, w = 予約
};

layout(std430, set = SHARC_SET, binding = 12) writeonly buffer SharcShadeRequests {
    SharcShadeRequest gpu_sharc_shade[];
};

#include "sharc_scene.glsl"

// ライト (太陽シャドウレイ用に lights[0] を参照)
struct SharcLight {
    vec4 posRadius;        // xyz = 位置 / 方向, w = 半径 (< 0 = directional)
    vec4 colorIntensity;
};

layout(std430, set = SHARC_SET, binding = 9) readonly buffer SharcLights {
    SharcLight gpu_sharc_lights[];
};

// アルベドテクスチャ配列 (1 レイヤ = 1 map_Kd、 REPEAT でタイル)。
// 未使用時は 1x1 白ダミーが結線される。
layout(set = SHARC_SET, binding = 18) uniform sampler2DArray sharcAlbedoAtlas;

float sharcRand2(inout uint state) {
    state = sharcHashUint(state);
    return float(state) * (1.0 / 4294967296.0);
}

void main() {
    uint rayIdx = gl_GlobalInvocationID.x;
    if (rayIdx >= sharcRayCount) return;
    if ((sharcSceneFlags & SHARC_SCENE_MESH) == 0u) return;

    // ── GPU レイ生成: 画素 index → カメラレイ (CPU 転送なし) ──
    uint renderW = uint(sharcCamUp.w);
    uint px = rayIdx % renderW;
    uint py = rayIdx / renderW;
    uint renderH = sharcRayCount / renderW;
    float fovScale = sharcCamFwd.w;
    float aspect   = sharcCamRight.w;
    float u = (2.0 * (float(px) + 0.5) / float(renderW) - 1.0)
            * fovScale * aspect;
    float v = (1.0 - 2.0 * (float(py) + 0.5) / float(renderH)) * fovScale;
    vec3 ro = sharcCameraPos.xyz;
    vec3 rd = normalize(sharcCamFwd.xyz + sharcCamRight.xyz * u
                        + sharcCamUp.xyz * v);
    vec3 invRd = 1.0 / vec3(
        abs(rd.x) > 1e-12 ? rd.x : 1e-12,
        abs(rd.y) > 1e-12 ? rd.y : 1e-12,
        abs(rd.z) > 1e-12 ? rd.z : 1e-12);

    // 初期 tMax は params の遠方値から取る (rays.tMax は前フレームの hit で
    // 締まっているため、 それを初期値にすると等値棄却で自己ミスする)。
    float best = sharcSceneRayFar;
    uint bestTri = 0xFFFFFFFFu;
    float bestU = 0.0, bestV = 0.0;

    // ── BVH トラバーサル (私有スタック) ──
    uint stack[48];
    int sp = 0;
    stack[sp++] = 0u;
    while (sp > 0) {
        uint ni = stack[--sp];
        SharcBvhNode node = gpu_sharc_bvh[ni];
        if (!sharcAabbHit(node.bminLeft.xyz, node.bmaxCount.xyz, ro, invRd,
                          best)) {
            continue;
        }
        uint count = floatBitsToUint(node.bmaxCount.w);
        if (count > 0u) {
            uint first = floatBitsToUint(node.bminLeft.w);
            for (uint i = 0u; i < count; i++) {
                float t, u, v;
                if (sharcTriHit(gpu_sharc_tris[first + i], ro, rd, best,
                                t, u, v)) {
                    best = t;
                    bestTri = first + i;
                    bestU = u; bestV = v;
                }
            }
        } else if (sp + 2 <= 48) {
            stack[sp++] = floatBitsToUint(node.bminLeft.w);   // right
            stack[sp++] = ni + 1u;                            // left
        }
    }

    // ── 解析床 (D2 用チェッカー。 Bistro は実地面があるので flags off) ──
    bool floorHit = false;
    if ((sharcSceneFlags & SHARC_SCENE_FLOOR) != 0u && rd.y < -1e-5) {
        float t = (sharcFloorY - ro.y) / rd.y;
        if (t > 1e-4 && t < best) {
            best = t;
            bestTri = 0xFFFFFFFFu;
            floorHit = true;
        }
    }

    SharcShadeRequest req;
    if (bestTri != 0xFFFFFFFFu) {
        SharcTri tri = gpu_sharc_tris[bestTri];
        vec3 pos = ro + rd * best;
        float w = 1.0 - bestU - bestV;
        vec3 n = normalize(
            w * sharcOct32Decode(floatBitsToUint(tri.v0.w)) +
            bestU * sharcOct32Decode(floatBitsToUint(tri.v1.w)) +
            bestV * sharcOct32Decode(floatBitsToUint(tri.v2.w)));
        if (dot(n, rd) > 0.0) n = -n;   // 裏面ヒット (逆光透過) は視線側へ
        SharcMaterial mat = gpu_sharc_materials[gpu_sharc_tri_mat[bestTri]];
        // albedo: テクスチャあり = 重心補間 UV で配列サンプル (Kd は乗数)。
        //         なし = マテリアル albedo (クレイ / PLY / 葉の緑)
        vec3 albedo = mat.albedoRough.rgb;
        float layerPlus1 = mat.mfpPad.y;
        vec2 uv = w * tri.uv01.xy + bestU * tri.uv01.zw
                + bestV * tri.uv2Pad.xy;
        if (layerPlus1 > 0.5) {
            // テクセルフットプリント LOD: 三角形の UV 面積 / ワールド面積比
            // から texel 密度を推定し、 1 ピクセルが覆う texel 数で選ぶ。
            // (絶対距離 log2 だと街路距離で mip 5-7 に飛びテクスチャが
            //  マテリアル平均色へ潰れる)
            vec3 e1w = tri.v1.xyz - tri.v0.xyz;
            vec3 e2w = tri.v2.xyz - tri.v0.xyz;
            float worldArea = max(length(cross(e1w, e2w)), 1e-12);
            vec2 e1t = tri.uv01.zw - tri.uv01.xy;
            vec2 e2t = tri.uv2Pad.xy - tri.uv01.xy;
            float uvArea = max(abs(e1t.x * e2t.y - e1t.y * e2t.x), 1e-12);
            float texelPerMeter = float(textureSize(sharcAlbedoAtlas, 0).x)
                                * sqrt(uvArea / worldArea);
            float pixelMeter = best * (2.0 * sharcCamFwd.w / float(renderH));
            float lod = clamp(log2(max(pixelMeter * texelPerMeter, 1.0)),
                              0.0, 9.0);
            albedo *= textureLod(sharcAlbedoAtlas,
                                 vec3(uv, layerPlus1 - 1.0), lod).rgb;
        }
#ifdef SHARC_DEBUG_ATLAS
        // 縦 3 分割デバッグ: 左 = 通常 / 中 = 生サンプル LOD0 / 右 = UV+layer
        uint band = (px * 3u) / renderW;
        if (band == 1u) {
            albedo = textureLod(sharcAlbedoAtlas,
                                vec3(uv, max(layerPlus1 - 1.0, 0.0)), 0.0).rgb;
        } else if (band == 2u) {
            albedo = vec3(fract(uv), layerPlus1 / 128.0);
        }
#endif
        // 太陽シャドウレイ (lights[0] が directional の場合):
        // 可視性をピクセル精度で求め、 resolve の解析直接光がシャープな
        // 影を落とす (シャドウマップ相当を BVH any-hit で代替)
        float sunVis = 1.0;
        if (sharcLightCount > 0u &&
            gpu_sharc_lights[0].posRadius.w < 0.0) {
            vec3 toSun = normalize(gpu_sharc_lights[0].posRadius.xyz);
            if (dot(n, toSun) > 0.0 &&
                sharcAnyHit(pos + n * 1.5e-2, toSun, 1.0e4)) {
                sunVis = 0.0;
            }
        }
        // ピクセル近接 AO: 法線半球の短距離レイ 2 本 (0.5m)。
        // 隅・軒下・接地部の「のっぺり感」対策。 シードはフレーム非依存で
        // 固定 (時間ノイズなし。 バイアスは近接 AO 用途では許容)
        float pixAo = 1.0;
        {
            uint aoRng = sharcHashUint(rayIdx * 2654435761u + 17u);
            uint hits = 0u;
            for (uint k = 0u; k < 2u; k++) {
                float z = sharcRand2(aoRng);
                float phi = 2.0 * SHARC_PI * sharcRand2(aoRng);
                float rxy = sqrt(max(1.0 - z * z, 0.0));
                vec3 d = vec3(rxy * cos(phi), z, rxy * sin(phi));
                if (dot(d, n) < 0.0) d = -d;   // 法線半球へ
                if (sharcAnyHit(pos + n * 1.0e-2, d, 0.5)) hits++;
            }
            pixAo = 1.0 - 0.35 * float(hits);   // 2 hit → 0.3
        }
        req.posRough   = vec4(pos, mat.albedoRough.a);
        req.normalMfp  = vec4(n, mat.mfpPad.x);
        req.albedoView = vec4(albedo, sunVis);
        req.viewDir    = vec4(-rd, pixAo);
    } else if (floorHit) {
        vec3 pos = ro + rd * best;
        int cx = int(floor(pos.x));
        int cz = int(floor(pos.z));
        float c = (((cx ^ cz) & 1) == 0) ? 0.55 : 0.30;
        req.posRough   = vec4(pos, 0.35);
        req.normalMfp  = vec4(0.0, 1.0, 0.0, 0.0);
        req.albedoView = vec4(c, c, c, 0.0);
        req.viewDir    = vec4(-rd, 0.0);
    } else {
        // ミス: albedo 0 → 出力 0 (空)。 march はセルを温める
        req.posRough   = vec4(0.0, 0.0, 0.0, 1.0);
        req.normalMfp  = vec4(0.0, 1.0, 0.0, 0.0);
        req.albedoView = vec4(0.0);
        req.viewDir    = vec4(0.0, 1.0, 0.0, 0.0);
    }
    gpu_sharc_shade[rayIdx] = req;
    // march 用レイを書き出す (tMax = 実ヒット距離で区間を締める)
    gpu_sharc_rays[rayIdx] = SharcRay(vec4(ro, 0.0), vec4(rd, best));
}
