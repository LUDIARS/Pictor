// Pictor — SHaRC 拡張 Pass 4: Resolve
//
// キャッシュ参照のみでシェーディングを閉じる (decoupled shading, spec §1/§3)。
// レイごとのシェーディング要求 (ヒット点 / 法線 / roughness / MFP / albedo) に
// 対して:
//   拡散   = 層1 モーメント (φ/4 + E·n/2)
//   鏡面   = 層2 vMF/SG ローブ × GGX-SG 閉形式 (パララックス再照準込み)
//   SSS    = MFP 選択レベルの近傍 M0/M1 ギャザー (Burley profile)
// を合成して出力バッファへ書く。 マーチ/シェーディング中に新規レイは撃たない。
//
// dispatch: (rayCount / 64, 1, 1)

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

#define SHARC_SET 0
#include "sharc_common.glsl"
#include "sharc_moments.glsl"
#include "sharc_lobes.glsl"

// シェーディング要求 (1 レイ = 1 サーフェスヒット)
struct SharcShadeRequest {
    vec4 posRough;     // xyz = ヒット点, w = roughness
    vec4 normalMfp;    // xyz = 法線 (外向き), w = SSS MFP (0 = SSS 無効)
    vec4 albedoView;   // rgb = albedo, a = 予約
    vec4 viewDir;      // xyz = ヒット点→カメラ方向, w = 予約
};

layout(std430, set = SHARC_SET, binding = 12) readonly buffer SharcShadeRequests {
    SharcShadeRequest gpu_sharc_shade[];
};

// 出力放射輝度 (rgb) + a = キャッシュヒット率 (デバッグ HUD 用)
layout(std430, set = SHARC_SET, binding = 13) writeonly buffer SharcOutput {
    vec4 gpu_sharc_output[];
};

void main() {
    uint rayIdx = gl_GlobalInvocationID.x;
    if (rayIdx >= sharcRayCount) return;

    SharcShadeRequest req = gpu_sharc_shade[rayIdx];
    vec3  pos       = req.posRough.xyz;
    float roughness = req.posRough.w;
    vec3  n         = normalize(req.normalMfp.xyz);
    float mfp       = req.normalMfp.w;
    vec3  albedo    = req.albedoView.rgb;
    vec3  v         = normalize(req.viewDir.xyz);

    // march はセル入口点の距離でレベルを選ぶため、 ヒット点の距離と
    // レベル境界を跨いでずれることがある。 ±1 レベルで救済して
    // キャッシュミス (黒斑点) を防ぐ。
    uint levelBase = sharcLevelFromDistance(distance(pos, sharcCameraPos.xyz));
    uint level = levelBase;
    ivec3 grid = sharcGridCoord(pos, level);
    uint slot  = sharcFindSlot(grid, level);
    if (slot == SHARC_SLOT_INVALID && levelBase > 0u) {
        level = levelBase - 1u;
        grid  = sharcGridCoord(pos, level);
        slot  = sharcFindSlot(grid, level);
    }
    if (slot == SHARC_SLOT_INVALID && levelBase + 1u < sharcLevelCount) {
        level = levelBase + 1u;
        grid  = sharcGridCoord(pos, level);
        slot  = sharcFindSlot(grid, level);
    }

    vec3 radiance = vec3(0.0);
    float hit = 0.0;

    if (slot != SHARC_SLOT_INVALID) {
        hit = 1.0;

        // --- 拡散 (層1 モーメント) ---
        vec3 m0, m1Dir, m1Mag; float conf;
        sharcLoadMoments(slot, m0, m1Dir, m1Mag, conf);
        vec3 irradiance = sharcDiffuseIrradiance(m0, m1Dir, m1Mag, n);
        radiance += albedo * SHARC_INV_PI * irradiance;

        // --- 鏡面 (層2 ローブ) ---
        vec3 cellCenter = sharcCellCenter(grid, level);
        vec3 spec = sharcSpecularEvaluate(slot, cellCenter, pos, n, v,
                                          roughness);
        // 簡易 Fresnel (F0 = 0.04 誘電体既定。 金属対応は material 結線時)
        float ndv = max(dot(n, v), SHARC_EPSILON);
        float f = 0.04 + 0.96 * pow(1.0 - ndv, 5.0);
        radiance += spec * f;
    }

    // --- SSS (層1, MFP レベルのギャザー) ---
    if (mfp > 0.0) {
        vec3 sss = sharcSssGather(pos, n, mfp, sharcLuminance(albedo));
        radiance += albedo * sss;
    }

    gpu_sharc_output[rayIdx] = vec4(radiance, hit);
}
