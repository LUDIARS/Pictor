// Pictor — SHaRC 拡張: 頂点 AO のロード時ベイク (一回きりの事前計算)
//
// シーンアップロード直後に executor がチャンク分割 dispatch で 1 回だけ
// 実行する。 三角形 3 コーナーごとに法線半球の短距離レイ 8 本を BVH
// any-hit で飛ばし、 遮蔽率を unorm8 × 3 として gpu_sharc_tri_ao へ書く。
// 以後の hit パスは実行時 AO レイの代わりに重心補間でこれを読む
// (ピクセルあたり BVH レイ 2 本の削減 — neco 指示 3)。
//
// チャンク分割は Windows TDR (既定 2 秒) 回避のため。 push constants で
// [base, base+count) の三角形範囲を受ける。
//
// dispatch: (count / 64, 1, 1) × チャンク数

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

#define SHARC_SET 0
#include "sharc_common.glsl"
#include "sharc_scene.glsl"

layout(push_constant) uniform SharcBakeRange {
    uint bakeBase;    // このチャンクの三角形開始 index
    uint bakeCount;   // チャンク内の三角形数
};

const uint  SHARC_BAKE_RAYS  = 8u;     // コーナーごとの半球レイ数
const float SHARC_BAKE_RANGE = 0.5;    // 到達距離 (m) — 旧ピクセル AO と同一
const float SHARC_BAKE_DARK  = 0.7;    // 全遮蔽時の減衰 (1-0.7 = 0.3)

float bakeRand(inout uint state) {
    state = sharcHashUint(state);
    return float(state) * (1.0 / 4294967296.0);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= bakeCount) return;
    uint triIdx = bakeBase + gid;

    SharcTri tri = gpu_sharc_tris[triIdx];
    vec3 corners[3] = vec3[3](tri.v0.xyz, tri.v1.xyz, tri.v2.xyz);
    uint normals[3] = uint[3](floatBitsToUint(tri.v0.w),
                              floatBitsToUint(tri.v1.w),
                              floatBitsToUint(tri.v2.w));

    uint packed = 0u;
    for (uint c = 0u; c < 3u; c++) {
        vec3 n = sharcOct32Decode(normals[c]);
        vec3 ro = corners[c] + n * 1.0e-2;
        uint rng = sharcHashUint(triIdx * 3u + c + 0x9E3779B9u);
        uint hits = 0u;
        for (uint k = 0u; k < SHARC_BAKE_RAYS; k++) {
            float z = bakeRand(rng);
            float phi = 2.0 * SHARC_PI * bakeRand(rng);
            float rxy = sqrt(max(1.0 - z * z, 0.0));
            vec3 d = vec3(rxy * cos(phi), z, rxy * sin(phi));
            if (dot(d, n) < 0.0) d = -d;   // 法線半球へ
            if (sharcAnyHit(ro, d, SHARC_BAKE_RANGE)) hits++;
        }
        float ao = 1.0 - SHARC_BAKE_DARK *
                         (float(hits) / float(SHARC_BAKE_RAYS));
        packed |= uint(clamp(ao, 0.0, 1.0) * 255.0 + 0.5) << (8u * c);
    }
    gpu_sharc_tri_ao[triIdx] = packed;
}
