# Consumer-face checks, CMake half (spec/architecture/multi-rhi.md §6 C2).
#
# 1. Writes the INTERFACE_COMPILE_DEFINITIONS a consumer of pictor_core / pictor
#    receives (transitive) to <build>/consumer_face/interface_definitions.txt.
#    tools/consumer_face/check_macro_propagation.py reports / checks it.
# 2. pictor_gfx_header_check: compiles every include/pictor/gfx/*.h on its own
#    (twice, to catch missing include guards) with no Pictor compile
#    definitions at all and strict warnings. Each translation unit also fails
#    if a backend macro is defined before or after the header.
#
# Included from the root CMakeLists.txt after every target that adds PUBLIC
# definitions to `pictor` has been configured.

file(GENERATE
    OUTPUT "${CMAKE_BINARY_DIR}/consumer_face/interface_definitions.txt"
    CONTENT "pictor_core=$<TARGET_PROPERTY:pictor_core,INTERFACE_COMPILE_DEFINITIONS>\npictor=$<TARGET_PROPERTY:pictor,INTERFACE_COMPILE_DEFINITIONS>\n"
)

option(PICTOR_BUILD_GFX_HEADER_CHECK
       "Compile each backend-neutral public header standalone (C2)" ON)

if(PICTOR_BUILD_GFX_HEADER_CHECK)
    file(GLOB _pictor_gfx_headers CONFIGURE_DEPENDS
         "${CMAKE_CURRENT_SOURCE_DIR}/include/pictor/gfx/*.h")

    set(_pictor_backend_macro_guard [=[
#if defined(PICTOR_HAS_VULKAN) || defined(PICTOR_HAS_DX12) || defined(PICTOR_HAS_D3D12) || \
    defined(PICTOR_HAS_METAL) || defined(PICTOR_HAS_WEBGL) || defined(PICTOR_HAS_WEBGPU) || \
    defined(PICTOR_RHI_VULKAN) || defined(PICTOR_RHI_D3D12) || defined(PICTOR_RHI_METAL) || \
    defined(PICTOR_RHI_WEBGPU) || defined(PICTOR_RHI_WEBGL2) || defined(PICTOR_RHI_NULL) || \
    defined(VK_VERSION_1_0) || defined(VK_USE_PLATFORM_WIN32_KHR) || defined(VK_USE_PLATFORM_XLIB_KHR)
#error "backend macro defined while checking the backend-neutral face"
#endif
]=])

    set(_pictor_gfx_check_sources "")
    foreach(_hdr ${_pictor_gfx_headers})
        get_filename_component(_name "${_hdr}" NAME_WE)
        set(_src "${CMAKE_BINARY_DIR}/consumer_face/gfx_header_${_name}.cpp")
        file(CONFIGURE OUTPUT "${_src}" CONTENT
"// Generated by cmake/PictorConsumerFaceChecks.cmake (C2). Do not edit.
${_pictor_backend_macro_guard}
#include \"pictor/gfx/${_name}.h\"
#include \"pictor/gfx/${_name}.h\"
${_pictor_backend_macro_guard}
")
        list(APPEND _pictor_gfx_check_sources "${_src}")
    endforeach()

    # Deliberately NOT linked to pictor / pictor_core: no compile definitions
    # flow in, only the include directory.
    add_library(pictor_gfx_header_check OBJECT ${_pictor_gfx_check_sources})
    target_include_directories(pictor_gfx_header_check PRIVATE
        "${CMAKE_CURRENT_SOURCE_DIR}/include")
    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(pictor_gfx_header_check PRIVATE -Wall -Wextra -Wpedantic -Werror)
    elseif(MSVC)
        target_compile_options(pictor_gfx_header_check PRIVATE /W4 /WX /utf-8)
    endif()

    unset(_pictor_gfx_headers)
    unset(_pictor_backend_macro_guard)
    unset(_pictor_gfx_check_sources)
endif()
