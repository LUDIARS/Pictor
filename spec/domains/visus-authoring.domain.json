{
  "name": "visus-authoring",
  "description": "Visus (メタデータ駆動の描画定義) の取り扱い。 型 / metadata、 シリアライズ (v2 読み書き・v1 読込互換)、 カタログ、 runtime 解決、 実体化 (instantiate)、 v1 移行、 パーサの堅牢性。",
  "presetRules": [],
  "templateRules": [],
  "membership": [
    {
      "pathPattern": "(^|/)src/visus/[^/]+$"
    },
    {
      "pathPattern": "(^|/)include/pictor/visus/[^/]+$"
    },
    {
      "pathPattern": "(^|/)tests/unit_(?:visus_[^/]+|parser_dos)_test\\.cpp$"
    },
    {
      "pathPattern": "(^|/)spec/feature/visus-v2-design\\.md$"
    },
    {
      "pathPattern": "(^|/)spec/tasks/[^/]*visus-v2[^/]*\\.md$"
    },
    {
      "pathPattern": "(^|/)tools/visus_migrate/[^/]+\\.cpp$"
    }
  ]
}
