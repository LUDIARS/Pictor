# lorica_applied_compile_commands_test — run with `cmake -P` (no Python).
#
# Reads the build tree's compile_commands.json and checks every translation unit of Pictor's
# own sources for the flags Lorica's baseline (LoricaHardening.cmake, pinned commit) adds on
# this toolchain, and for flags that cancel them. Source-built GLFW (C, third party) is
# checked separately for the C baseline only: no Lorica include, no forced C++ header, no
# C++ standard library macros. Any other third-party entry is counted and not checked.
# A missing flag fails the test with the file names.
#
# -D inputs (tests/lorica_applied/CMakeLists.txt):
#   MODE              gnu | msvc | unsupported | no-export
#   REASON            why the test cannot run (MODE unsupported / no-export)
#   COMPILE_COMMANDS  path to compile_commands.json
#   SOURCE_DIR BINARY_DIR   Pictor's source and binary directories
#   EXCLUDE_DIRS      ;-separated (as |) directories that are not Pictor's own (third_party/, Lorica)
#   LORICA_INCLUDE_DIR      expected Lorica include directory (own C/C++ units)
#   UNSAFE_API_HEADER       forced header path, empty when the rejection is not applied
#   CFP_FLAG          -fcf-protection=full | -mbranch-protection=standard
#   FORTIFY_C FORTIFY_CXX   expected _FORTIFY_SOURCE level, empty when none is expected
#   GLFW_SOURCE_DIR   source-built GLFW, empty when GLFW is not built here or not hardened
#
# Skips print "PICTOR_LORICA_SKIP:" (the test's SKIP_REGULAR_EXPRESSION) and stop.

cmake_minimum_required(VERSION 3.20)

if(MODE STREQUAL "unsupported" OR MODE STREQUAL "no-export")
    message("PICTOR_LORICA_SKIP: ${REASON}")
    return()
endif()
if(NOT EXISTS "${COMPILE_COMMANDS}")
    message(FATAL_ERROR "compile_commands.json not found at ${COMPILE_COMMANDS} although CMAKE_EXPORT_COMPILE_COMMANDS is ON; re-run configure")
endif()

file(READ "${COMPILE_COMMANDS}" json)
string(JSON count LENGTH "${json}")
string(REPLACE "|" ";" EXCLUDE_DIRS "${EXCLUDE_DIRS}")

function(_under path dir out)
    if(dir STREQUAL "")
        set(${out} FALSE PARENT_SCOPE)
        return()
    endif()
    cmake_path(IS_PREFIX dir "${path}" NORMALIZE inside)
    set(${out} ${inside} PARENT_SCOPE)
endfunction()

# Last token of the family `regex`; empty when none.
function(_last tokens regex out)
    set(result "")
    foreach(token IN LISTS tokens)
        if(token MATCHES "${regex}")
            set(result "${token}")
        endif()
    endforeach()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

# Final state of a preprocessor macro after every -D / -U in order: UNDEF, or its value
# (-DNAME alone is 1). Handles "-DNAME=V" and "-D NAME=V".
function(_macro tokens name out)
    # cl also takes /D and /U; on Unix a /U... token is a path.
    if(MODE STREQUAL "msvc")
        set(prefix "[-/]")
    else()
        set(prefix "-")
    endif()
    set(state UNDEF)
    set(pending "")
    foreach(token IN LISTS tokens)
        if(NOT pending STREQUAL "")
            set(arg "${token}")
            set(kind "${pending}")
            set(pending "")
        elseif(token MATCHES "^${prefix}[DU]$")
            string(SUBSTRING "${token}" 1 1 pending)
            continue()
        elseif(token MATCHES "^${prefix}([DU])(.+)$")
            set(kind "${CMAKE_MATCH_1}")
            set(arg "${CMAKE_MATCH_2}")
        else()
            continue()
        endif()
        if(arg MATCHES "^([A-Za-z_][A-Za-z0-9_]*)(=(.*))?$" AND CMAKE_MATCH_1 STREQUAL name)
            if(kind STREQUAL "U")
                set(state UNDEF)
            elseif(NOT CMAKE_MATCH_2 STREQUAL "")
                set(state "${CMAKE_MATCH_3}")
            else()
                set(state 1)
            endif()
        endif()
    endforeach()
    set(${out} "${state}" PARENT_SCOPE)
endfunction()

# Problems of one GCC/Clang command; language C or CXX; own TRUE for Pictor's sources.
function(_check_gnu tokens lang own out)
    set(problems "")
    _last("${tokens}" "^-f(no-)?stack-protector(-[a-z]+)?$" v)
    if(NOT v MATCHES "^-fstack-protector-(strong|all)$")
        list(APPEND problems "stack protector is '${v}', not -fstack-protector-strong")
    endif()
    _last("${tokens}" "^-f(no-)?stack-clash-protection$" v)
    if(NOT v STREQUAL "-fstack-clash-protection")
        list(APPEND problems "stack clash protection is '${v}'")
    endif()
    if(CFP_FLAG MATCHES "^-fcf-protection")
        _last("${tokens}" "^-f(no-)?cf-protection(=.*)?$" v)
        if(NOT v MATCHES "^-fcf-protection(=full)?$")
            list(APPEND problems "control-flow protection is '${v}', not ${CFP_FLAG}")
        endif()
    else()
        _last("${tokens}" "^-mbranch-protection=" v)
        if(NOT v STREQUAL CFP_FLAG)
            list(APPEND problems "branch protection is '${v}', not ${CFP_FLAG}")
        endif()
    endif()
    _macro("${tokens}" _FORTIFY_SOURCE v)
    if(FORTIFY_${lang})
        if(NOT v STREQUAL FORTIFY_${lang})
            list(APPEND problems "_FORTIFY_SOURCE is '${v}', not ${FORTIFY_${lang}}")
        endif()
    elseif(v MATCHES "^0$")
        list(APPEND problems "_FORTIFY_SOURCE=0")
    endif()
    if(lang STREQUAL "CXX")
        _macro("${tokens}" _GLIBCXX_ASSERTIONS v)
        if(v STREQUAL "UNDEF")
            list(APPEND problems "_GLIBCXX_ASSERTIONS is not defined")
        endif()
        _macro("${tokens}" _LIBCPP_HARDENING_MODE v)
        if(NOT v MATCHES "^_LIBCPP_HARDENING_MODE_(FAST|EXTENSIVE)$")
            list(APPEND problems "_LIBCPP_HARDENING_MODE is '${v}'")
        endif()
    endif()
    if(own)
        set(found FALSE)
        set(previous "")
        foreach(token IN LISTS tokens)
            if(token STREQUAL "-I${LORICA_INCLUDE_DIR}" OR token STREQUAL "-isystem${LORICA_INCLUDE_DIR}" OR
               (previous MATCHES "^-(I|isystem)$" AND token STREQUAL LORICA_INCLUDE_DIR))
                set(found TRUE)
            endif()
            set(previous "${token}")
        endforeach()
        if(NOT found)
            list(APPEND problems "Lorica include directory ${LORICA_INCLUDE_DIR} missing")
        endif()
        if(lang STREQUAL "CXX" AND UNSAFE_API_HEADER)
            set(forced FALSE)
            set(previous "")
            foreach(token IN LISTS tokens)
                if(previous STREQUAL "-include" AND token STREQUAL UNSAFE_API_HEADER)
                    set(forced TRUE)
                endif()
                set(previous "${token}")
            endforeach()
            if(NOT forced)
                list(APPEND problems "forced include of ${UNSAFE_API_HEADER} missing")
            endif()
            _last("${tokens}" "^-W(no-)?(error=)?deprecated-declarations$|^-Wno-error=deprecated-declarations$" v)
            if(NOT v STREQUAL "-Werror=deprecated-declarations")
                list(APPEND problems "deprecated-declarations is '${v}', not -Werror=deprecated-declarations")
            endif()
            if("-w" IN_LIST tokens)
                list(APPEND problems "-w silences the unsafe API rejection")
            endif()
        endif()
    else()
        foreach(token IN LISTS tokens)
            if(token MATCHES "unsafe_api\\.hpp$")
                list(APPEND problems "C++ unsafe API header forced into a third-party unit")
            endif()
        endforeach()
    endif()
    set(${out} "${problems}" PARENT_SCOPE)
endfunction()

# MSVC (cl with a Ninja / Makefile generator): /GS /sdl /guard:cf, /we4996 for the rejection.
function(_check_msvc tokens lang own out)
    set(problems "")
    foreach(pair "GS" "sdl" "guard:cf")
        string(REPLACE ":" "\\:" key "${pair}")
        _last("${tokens}" "^[-/]${key}-?$" v)
        if(NOT v MATCHES "^[-/]${key}$")
            list(APPEND problems "/${pair} is '${v}'")
        endif()
    endforeach()
    if(own AND lang STREQUAL "CXX" AND UNSAFE_API_HEADER)
        _last("${tokens}" "^[-/]w[de0-4]?4996$" v)
        if(NOT v MATCHES "^[-/]we4996$")
            list(APPEND problems "C4996 is '${v}', not /we4996")
        endif()
    endif()
    set(${out} "${problems}" PARENT_SCOPE)
endfunction()

set(own_checked 0)
set(glfw_checked 0)
set(skipped 0)
set(failures "")
math(EXPR last "${count} - 1")
foreach(i RANGE 0 ${last})
    string(JSON file GET "${json}" ${i} file)
    string(JSON directory GET "${json}" ${i} directory)
    if(NOT IS_ABSOLUTE "${file}")
        set(file "${directory}/${file}")
    endif()
    cmake_path(NORMAL_PATH file)

    set(kind other)
    _under("${file}" "${GLFW_SOURCE_DIR}" in_glfw)
    _under("${file}" "${SOURCE_DIR}" in_source)
    _under("${file}" "${BINARY_DIR}" in_binary)
    _under("${file}" "${BINARY_DIR}/_deps" in_deps)
    if(in_glfw)
        set(kind glfw)
    elseif(in_deps)
        set(kind other)
    elseif(in_source OR in_binary)
        set(kind own)
        foreach(excluded IN LISTS EXCLUDE_DIRS)
            _under("${file}" "${excluded}" in_excluded)
            if(in_excluded)
                set(kind other)
            endif()
        endforeach()
    endif()
    if(kind STREQUAL "other")
        math(EXPR skipped "${skipped} + 1")
        continue()
    endif()

    string(JSON command ERROR_VARIABLE no_command GET "${json}" ${i} command)
    if(no_command)
        # "arguments" form: a JSON array of already separated tokens.
        string(JSON n LENGTH "${json}" ${i} arguments)
        set(tokens "")
        math(EXPR n_last "${n} - 1")
        foreach(j RANGE 0 ${n_last})
            string(JSON token GET "${json}" ${i} arguments ${j})
            list(APPEND tokens "${token}")
        endforeach()
    elseif(MODE STREQUAL "msvc")
        separate_arguments(tokens WINDOWS_COMMAND "${command}")
    else()
        separate_arguments(tokens UNIX_COMMAND "${command}")
    endif()

    if(file MATCHES "\\.c$")
        set(lang C)
    else()
        set(lang CXX)
    endif()
    if(kind STREQUAL "own")
        set(own TRUE)
        math(EXPR own_checked "${own_checked} + 1")
    else()
        set(own FALSE)
        math(EXPR glfw_checked "${glfw_checked} + 1")
    endif()
    if(MODE STREQUAL "msvc")
        _check_msvc("${tokens}" ${lang} ${own} problems)
    else()
        _check_gnu("${tokens}" ${lang} ${own} problems)
    endif()
    if(problems)
        string(REPLACE ";" ", " problems "${problems}")
        list(APPEND failures "${file} (${lang}): ${problems}")
    endif()
endforeach()

if(own_checked EQUAL 0)
    message(FATAL_ERROR "no Pictor-owned translation unit found in ${COMPILE_COMMANDS}")
endif()
if(GLFW_SOURCE_DIR AND glfw_checked EQUAL 0)
    message(FATAL_ERROR "GLFW is built from ${GLFW_SOURCE_DIR} but none of its units is in ${COMPILE_COMMANDS}")
endif()
message(STATUS "checked ${own_checked} Pictor units and ${glfw_checked} GLFW units; ${skipped} other third-party units not checked")
if(failures)
    list(LENGTH failures n_failures)
    string(REPLACE ";" "\n  " failures "${failures}")
    message(FATAL_ERROR "${n_failures} translation unit(s) without Lorica's settings:\n  ${failures}")
endif()
